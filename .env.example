DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=stlouisgurudwara.org,www.stlouisgurudwara.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://stlouisgurudwara.org,https://www.stlouisgurudwara.org
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_HSTS_SECONDS=300
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

DB_ENGINE=django.db.backends.postgresql
DB_NAME=gurudwara
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
# For MySQL use DB_ENGINE=django.db.backends.mysql and DB_PORT=3306.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
EMAIL_HOST_USER=noreply@stlouisgurudwara.org
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=noreply@stlouisgurudwara.org
SERVER_EMAIL=noreply@stlouisgurudwara.org
